{
    "name": "evo-mark/lscache-laravel-inertia",
    "description": "Litespeed cache support for applications running Laravel Inertia",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "EvoMark\\LscacheLaravelInertia\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "require": {
        "php": ">=8.4",
        "illuminate/support": "^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.93"
    },
    "extra": {
        "laravel": {
            "providers": [
                "EvoMark\\LscacheLaravelInertia\\Provider"
            ]
        }
    },
    "prefer-stable": true
}
